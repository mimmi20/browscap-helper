{
  "name": "mimmi20/browscap-helper",
  "description": "some small helper functions for working with Browscap",
  "license": "MIT",
  "authors": [
    {
      "name": "Thomas Müller",
      "homepage": "https://github.com/mimmi20",
      "role": "Developer"
    },
    {
      "name": "Contributors",
      "homepage": "https://github.com/mimmi20/browscap-helper/graphs/contributors"
    }
  ],
  "require": {
    "php": "~8.5.0 || ~8.6.0",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "donatj/phpuseragentparser": "^1.12.0",
    "ergebnis/json": "^1.8.0",
    "ergebnis/json-normalizer": "^4.13.0",
    "jaybizzle/crawler-detect": "^1.4.3",
    "matomo/device-detector": "^6.5.2",
    "mimmi20/browscap-helper-source": "^11.0.0",
    "mimmi20/browser-detector": "^11.0.24",
    "mimmi20/browser-detector-version": "^14.0.3",
    "mimmi20/browser-detector-versioninterface": "^2.0.3",
    "mimmi20/ua-browser-type": "^13.0.4",
    "mimmi20/ua-data-interface": "^3.0.1",
    "mimmi20/ua-data-mapper": "^6.0.29",
    "mimmi20/ua-device-type": "^13.0.2",
    "mimmi20/ua-generic-request": "^19.0.2",
    "mimmi20/ua-loader-interface": "^7.0.6",
    "mimmi20/ua-normalizer": "^9.0.43",
    "mimmi20/ua-result": "^17.0.3",
    "mobiledetect/mobiledetectlib": "^4.11.0",
    "monolog/monolog": "^3.13.0",
    "psr/log": "^3.0.2",
    "psr/simple-cache": "^3.0.0",
    "symfony/cache": "^8.1.11",
    "symfony/console": "^8.1.11",
    "symfony/finder": "^8.1.11",
    "symfony/yaml": "^8.1.12",
    "whichbrowser/parser": "^2.1.8",
    "woothee/woothee-testset": "^1.13.0"
  },
  "require-dev": {
    "ergebnis/composer-normalize": "^2.58.0",
    "jbelien/phpstan-sarif-formatter": "^1.2.0",
    "mimmi20/coding-standard": "^8.0.34",
    "phpstan/extension-installer": "^1.4.3",
    "phpstan/phpstan": "^2.3.7",
    "phpstan/phpstan-deprecation-rules": "^2.0.5",
    "rector/rector": "^2.8.5",
    "shipmonk/composer-dependency-analyser": "^1.8.4",
    "symplify/phpstan-rules": "^14.19.4",
    "tomasvotruba/cognitive-complexity": "^1.3.0",
    "tomasvotruba/type-coverage": "^2.5.1",
    "tomasvotruba/unused-public": "^2.2.1"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "BrowscapHelper\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BrowscapHelperTest\\": "tests/"
    }
  },
  "bin": [
    "bin/browscap-helper.php"
  ],
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "ergebnis/composer-normalize": true,
      "phpstan/extension-installer": true
    },
    "lock": false,
    "preferred-install": {
      "browscap/browscap": "source",
      "donatj/phpuseragentparser": "source",
      "jaybizzle/crawler-detect": "source",
      "matomo/device-detector": "source",
      "mimmi20/browser-detector": "source",
      "mobiledetect/mobiledetectlib": "source",
      "whichbrowser/parser": "source",
      "woothee/woothee-testset": "source",
      "zsxsoft/php-useragent": "source",
      "*": "dist"
    },
    "sort-packages": true
  },
  "extra": {
    "composer-normalize": {
      "indent-size": 2,
      "indent-style": "space"
    }
  }
}
